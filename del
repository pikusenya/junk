}

// --- 3. Генератор настроек действия ---

function initActionGenerator() {
    const container = document.getElementById('action-generator');
    const jsonField = document.querySelector('[name="action_config"]');
    const actionTypeField = document.querySelector('[name="action_type"]');
    
    if (!container || !jsonField || !actionTypeField) return;
    
    // Слушаем изменения типа действия
    actionTypeField.addEventListener('change', function() {
        renderActionForm(container, jsonField, this.value);
    });
    
    // Инициализируем форму
    renderActionForm(container, jsonField, actionTypeField.value);
}

function renderActionForm(container, jsonField, actionType) {
    let config = {};
    try {
        config = JSON.parse(jsonField.value || '{}');
    } catch (e) {
        config = {};
    }
    
    let formHTML = '';
    
    if (actionType === 'print') {
        formHTML = `
            <label>Сообщение</label>
            <input type="text" id="action-message-input" value="${config.message || ''}" placeholder="Текст сообщения">
            <p class="help-text">Доступные переменные: {field}, {old_value}, {new_value}</p>
        `;
    } else if (actionType === 'email') {
        formHTML = `
            <label>Тема письма</label>
            <input type="text" id="action-subject-input" value="${config.subject || ''}" placeholder="Тема">
            
            <label>Шаблон сообщения</label>
            <textarea id="action-template-input" rows="3" placeholder="Текст письма">${config.template || ''}</textarea>
        `;
    } else if (actionType === 'webhook') {
        formHTML = `
            <label>URL</label>
            <input type="url" id="action-url-input" value="${config.url || ''}" placeholder="https://...">
            
            <label>Метод</label>
            <select id="action-method-select">
                <option value="POST" ${config.method === 'POST' ? 'selected' : ''}>POST</option>
                <option value="GET" ${config.method === 'GET' ? 'selected' : ''}>GET</option>
            </select>
        `;
    } else if (actionType === 'update_field') {
        formHTML = `
            <label>Поле для обновления</label>
            <input type="text" id="action-field-input" value="${config.field || ''}" placeholder="field_name">
            
            <label>Шаблон нового значения</label>
            <input type="text" id="action-value-template-input" value="${config.value_template || ''}" placeholder="{new_value} [UPDATED]">
        `;
    } else {
        formHTML = '<p class="help-text">Настройки для этого типа действия пока не реализованы</p>';
    }
    
    formHTML += `<button type="button" id="action-apply-btn">Применить в JSON</button>`;
    
    container.innerHTML = formHTML;
    
    // Обработчик кнопки
    document.getElementById('action-apply-btn')?.addEventListener('click', function() {
        const newConfig = {};
        
        if (actionType === 'print') {
            newConfig.message = document.getElementById('action-message-input').value;
        } else if (actionType === 'email') {
            newConfig.subject = document.getElementById('action-subject-input').value;
            newConfig.template = document.getElementById('action-template-input').value;
        } else if (actionType === 'webhook') {
            newConfig.url = document.getElementById('action-url-input').value;
            newConfig.method = document.getElementById('action-method-select').value;
        } else if (actionType === 'update_field') {
            newConfig.field = document.getElementById('action-field-input').value;
            newConfig.value_template = document.getElementById('action-value-template-input').value;
        }
        
        jsonField.value = JSON.stringify(newConfig, null, 2);
        
        this.textContent = '✅ Применено!';
        setTimeout(() => { this.textContent = 'Применить в JSON'; }, 1500);
    });
}
