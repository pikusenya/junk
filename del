$('#my-select').select2({
  matcher: function (params, data) {
    // Если поле поиска пустое — показываем всё
    if ($.trim(params.term) === '') {
      return data;
    }

    if (!data.text) {
      return null;
    }

    const term = params.term.toLowerCase();
    const text = data.text.toLowerCase();
    
    // data.element — это оригинальный <option> из DOM
    const email = (data.element.dataset.email || '').toLowerCase();
    const phone = (data.element.dataset.phone || '').toLowerCase();

    // Проверяем совпадение хотя бы в одном поле
    if (text.includes(term) || email.includes(term) || phone.includes(term)) {
      return data;
    }

    return null; // опция скрывается
  }
});
