document.addEventListener('DOMContentLoaded', function() {
    initSubcardFieldsPanel();
    initTriggerGenerator();
    initActionGenerator();
});

// --- 1. Панель полей субкарты ---

function initSubcardFieldsPanel() {
    const contentTypeField = document.querySelector('[name="content_type"]');
    const container = document.getElementById('subcard-fields-container');
    
    if (!contentTypeField || !container) return;
    
    contentTypeField.addEventListener('change', function() {
        loadSubcardFields(this.value, container);
    });
    
    // Загрузить при инициализации, если модель уже выбрана
    if (contentTypeField.value) {
        loadSubcardFields(contentTypeField.value, container);
    }
}

function loadSubcardFields(contentTypeId, container) {
    if (!contentTypeId) {
        container.innerHTML = '<p class="help-text">Модель не выбрана</p>';
        return;
    }
    
    container.innerHTML = '<p class="help-text">Загрузка...</p>';
    
    fetch(`/automation/api/get-model-relations/?content_type_id=${contentTypeId}`)
        .then(response => response.json())
        .then(data => {
            if (data.has_subcard_relation && data.relations.length > 0) {
                // Загружаем поля первой найденной субкарты
                const relationPath = data.relations[0].path;
                loadSubcardFieldList(relationPath, container);
            } else {
                container.innerHTML = '<p class="help-text">⚠️ Связь с субкартой не найдена</p>';
            }
        })
        .catch(error => {
            container.innerHTML = '<p class="help-text">❌ Ошибка загрузки</p>';
            console.error('Error:', error);
        });
}

function loadSubcardFieldList(relationPath, container) {
