import httpx
import time
from loguru import logger
from tenacity import retry, stop_after_attempt, wait_exponential, retry_if_exception_type
from parser.config import BASE_URL, DEFAULT_HEADERS, DEFAULT_COOKIES, REQUEST_DELAY, MAX_RETRIES


class GisZhkhClient:
    def __init__(self):
        self.client = httpx.Client(
            base_url=BASE_URL,
            headers=DEFAULT_HEADERS,
            cookies=DEFAULT_COOKIES,
            timeout=30.0,
            follow_redirects=True
        )
        self._last_request_time = 0

    def _throttle(self):
        elapsed = time.time() - self._last_request_time
        if elapsed < REQUEST_DELAY:
            time.sleep(REQUEST_DELAY - elapsed)
        self._last_request_time = time.time()

    @retry(
        stop=stop_after_attempt(MAX_RETRIES),
        wait=wait_exponential(multiplier=1, min=2, max=10),
        retry=retry_if_exception_type((httpx.HTTPError, httpx.TimeoutException)),
        reraise=True
    )
    def request(self, method: str, url: str, headers: dict = None, **kwargs) -> dict:
        self._throttle()
        final_headers = DEFAULT_HEADERS.copy()
        if headers:
            final_headers.update(headers)

        logger.debug(f"Отправка {method} запроса к: {url}")
        response = self.client.request(method, url, headers=final_headers, **kwargs)
        response.raise_for_status()
        return response.json()

    def get_html(self, url: str) -> str:
        """Получает сырой HTML-код страницы с правильными заголовками для Next.js"""
        self._throttle()
        html_headers = {
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9,ru;q=0.8",
            "Cache-Control": "max-age=0",
            "DNT": "1",
            "Referer": "https://portal.dom.gosuslugi.ru/",
            "Sec-Fetch-Dest": "document",
            "Sec-Fetch-Mode": "navigate",
            "Sec-Fetch-Site": "same-origin",
            "Sec-Fetch-User": "?1",
            "Upgrade-Insecure-Requests": "1",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/158.0.0.0 Safari/537.36",
            "sec-ch-ua": '"Chromium";v="158", "Not.A/Brand";v="24", "Brave";v="158"',
            "sec-ch-ua-mobile": "?0",
            "sec-ch-ua-platform": '"Windows"',
            "sec-gpc": "1"
        }
        logger.debug(f"Запрос HTML страницы: {url}")
        response = self.client.get(url, headers=html_headers)
        response.raise_for_status()
        return response.text

    def close(self):
        self.client.close()

