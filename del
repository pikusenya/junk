from dataclasses import dataclass, field
from typing import List, Optional

@dataclass
class ManagementCompany:
    name: str = ""
    url: str = ""
    phone: str = ""
    email: str = ""
    inn: str = ""
    ogrn: str = ""
    kpp: str = ""
    address: str = ""

@dataclass
class UtilityProvider:
    provider_id: str = ""
    provider_type: str = ""      # "RSO" или "TKO" или "UO"
    service_type: str = ""       # Вид услуги (например, "Холодное водоснабжение")
    company_name: str = ""
    email: str = ""              # Обязательно
    phone: str = ""
    url: str = ""
    inn: str = ""
    ogrn: str = ""
    kpp: str = ""
    address: str = ""

@dataclass
class HouseResult:
    address: str
    house_id: Optional[str] = None

    # Информация из suggest API
    found_addresses_count: int = 0
    all_found_addresses: List[str] = field(default_factory=list)
    selected_address_formatted: Optional[str] = None

    # Контактная информация
    uo: Optional[ManagementCompany] = None
    providers: List[UtilityProvider] = field(default_factory=list)

    # Для отладки (обязательно оставляем, чтобы не ломалось)
    error: Optional[str] = None
    raw_search_response: Optional[dict] = None
    raw_suggest_response: Optional[dict] = None


