// Controller.js
window.FilterController = {
    state: {
        selectedRoom: null,
        selectedTenant: null,
        roomSearch: '',
        tenantSearch: ''
    },
    
    init() {
        // Поиск по вводу
        document.querySelectorAll('.filter-input').forEach(input => {
            input.addEventListener('input', (e) => this.handleSearch(e));
        });
        
        // Клик по элементу списка
        document.querySelectorAll('.items-list').forEach(list => {
            list.addEventListener('click', (e) => this.handleItemClick(e));
        });
        
        // Кнопка сброса
        document.querySelectorAll('.filter-reset').forEach(btn => {
            btn.addEventListener('click', (e) => this.resetFilters(e));
        });
    },
    
    // === ОБРАБОТКА КЛИКА ПО ЭЛЕМЕНТУ ===
    handleItemClick(e) {
        const item = e.target.closest('.item');
        if (!item) return;
        
        const list = item.closest('.items-list');
        const type = list.dataset.type; // 'room' или 'tenant'
        const id = parseInt(item.dataset.id);
        
        // Переключение выделения
        if (this.state[`selected${this.capitalize(type)}`] === id) {
            // Снимаем выделение
            this.state[`selected${this.capitalize(type)}`] = null;
            item.classList.remove('selected');
        } else {
            // Выделяем новый
            list.querySelectorAll('.item.selected').forEach(i => i.classList.remove('selected'));
            item.classList.add('selected');
            this.state[`selected${this.capitalize(type)}`] = id;
        }
        
        // Запускаем перекрёстную фильтрацию
        this.applyCrossFilter();
    },
    
    // === ПОИСК ПО ТЕКСТУ ===
    handleSearch(e) {
        const input = e.target;
        const list = input.closest('.panel-section').querySelector('.items-list');
        const type = list.dataset.type;
        const query = input.value.toLowerCase().trim();
        
        this.state[`${type}Search`] = query;
        this.updateResetButton(list);
        this.applyTextFilter(list, query);
        this.applyCrossFilter(); // Перекрёстный фильтр поверх текстового
    },
    
    applyTextFilter(list, query) {
        if (!query) {
            list.querySelectorAll('.item').forEach(item => {
                item.classList.remove('filtered-out');
            });
            return;
        }
        
        list.querySelectorAll('.item').forEach(item => {
            const name = item.dataset.name.toLowerCase();
            const status = item.dataset.status.toLowerCase();
            
            // Ищем по имени ИЛИ по статусу
            const matches = name.includes(query) || status.includes(query);
            item.classList.toggle('filtered-out', !matches);
        });
    },
    
    // === ПЕРЕКРЁСТНАЯ ФИЛЬТРАЦИЯ ===
    applyCrossFilter() {
        const { selectedRoom, selectedTenant } = this.state;
        
        // Фильтруем помещения
        const roomsList = document.getElementById('rooms-list');
        roomsList.querySelectorAll('.item').forEach(item => {
            if (item.classList.contains('filtered-out')) return; // Уже скрыт поиском
            
            // Если выбран арендатор — показываем только связанные помещения
            if (selectedTenant) {
                const roomTenantIds = item.dataset.tenantIds?.split(',').map(Number) || [];
                const isVisible = roomTenantIds.includes(selectedTenant);
                item.classList.toggle('cross-filtered', !isVisible);
            } else {
                item.classList.remove('cross-filtered');
            }
        });
        
        // Фильтруем арендаторов
        const tenantsList = document.getElementById('tenants-list');
        tenantsList.querySelectorAll('.item').forEach(item => {
            if (item.classList.contains('filtered-out')) return;
            
            // Если выбрано помещение — показываем только связанных арендаторов
            if (selectedRoom) {
                const tenantRoomIds = item.dataset.roomIds?.split(',').map(Number) || [];
                const isVisible = tenantRoomIds.includes(selectedRoom);
                item.classList.toggle('cross-filtered', !isVisible);
            } else {
                item.classList.remove('cross-filtered');
            }
        });
        
        // Применяем комбинированную видимость
        this.updateVisibility();
    },
    
    updateVisibility() {
        // Элемент виден, если не скрыт ни поиском, ни перекрёстным фильтром
        document.querySelectorAll('.item').forEach(item => {
            const isHiddenByText = item.classList.contains('filtered-out');
            const isHiddenByCross = item.classList.contains('cross-filtered');
            item.style.display = (isHiddenByText || isHiddenByCross) ? 'none' : '';
        });
    },
    
    // === СБРОС ФИЛЬТРОВ ===
    resetFilters(e) {
        const panel = e.target.closest('.panel-section');
        const list = panel.querySelector('.items-list');
        const type = list.dataset.type;
        
        // Сбрасываем поиск
        panel.querySelector('.filter-input').value = '';
        this.state[`${type}Search`] = '';
        
        // Сбрасываем выделение
        if (type === 'room') {
            this.state.selectedRoom = null;
        } else {
            this.state.selectedTenant = null;
        }
        
        // Показываем все элементы
        list.querySelectorAll('.item').forEach(item => {
            item.classList.remove('filtered-out', 'cross-filtered', 'selected');
            item.style.display = '';
        });
        
        this.updateResetButton(list);
    },
    
    updateResetButton(list) {
        const panel = list.closest('.panel-section');
        const btn = panel.querySelector('.filter-reset');
        const input = panel.querySelector('.filter-input');
        const hasActiveFilters = input.value.trim() || 
                                 list.querySelector('.item.selected');
        btn.classList.toggle('active', !!hasActiveFilters);
    },
    
    capitalize(str) {
        return str.charAt(0).toUpperCase() + str.slice(1);
    }
};

// Инициализация
document.addEventListener('DOMContentLoaded', () => {
    FilterController.init();
});



// Model.js
window.EditorModel = {
    subcards: {}, // { id: { id, name, status, area, relatedTenantIds, ...} }
    tenants: {},  // { id: { id, name, status, relatedRoomIds, ...} }
    
    // Загрузка данных с бэкенда
    loadRelatedData(rooms, tenants) {
        rooms.forEach(room => {
            this.subcards[room.id] = {
                ...room,
                relatedTenantIds: room.tenant_ids || []
            };
        });
        
        tenants.forEach(tenant => {
            this.tenants[tenant.id] = {
                ...tenant,
                relatedRoomIds: tenant.room_ids || []
            };
        });
    },
    
    // Получить связанные арендаторы для помещения
    getTenantsForRoom(roomId) {
        const room = this.subcards[roomId];
        if (!room) return [];
        return room.relatedTenantIds.map(id => this.tenants[id]).filter(Boolean);
    },
    
    // Получить связанные помещения для арендатора
    getRoomsForTenant(tenantId) {
        const tenant = this.tenants[tenantId];
        if (!tenant) return [];
        return tenant.relatedRoomIds.map(id => this.subcards[id]).filter(Boolean);
    }
};


