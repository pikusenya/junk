@api_view(['PUT', 'PATCH'])
def update_floorplan(request, floorplan_id):
    floor_plan = get_object_or_404(FloorPlan, id=floorplan_id)
    
    updated_data = request.data
    serializer = FloorPlanSerializer(floor_plan, data=updated_data, partial=True)
    
    failed_subcards = []
    
    if 'subcards_updates' in updated_data:
        subcards_updates = json.loads(updated_data['subcards_updates'])
        
        for sub_upd in subcards_updates:
            sub_id = int(sub_upd['subcard_id'])
            
            try:
                subcard = SubCard.objects.get(id=sub_id)  # ← Проверь имя поля (sub_id или id)
            except SubCard.DoesNotExist:
                failed_subcards.append(sub_id)
                continue
            
            # Обновляем координаты
            if 'coords' in sub_upd:
                subcard.coords = sub_upd['coords']
                subcard.save(update_fields=['coords'])
            
            # Привязываем к этажу
            if 'add_to_floorplan' in sub_upd and sub_upd['add_to_floorplan']:
                floor_plan.subcard_ids.add(subcard)
            
            # Отвязываем от этажа
            if 'remove_from_floorplan' in sub_upd and sub_upd['remove_from_floorplan']:
                floor_plan.subcard_ids.remove(subcard)
    
    if serializer.is_valid():
        serializer.save()
    
    resp_data = {
        "success": True,
        'message': "Этаж успешно обновлён"
    }
    
    if failed_subcards:
        resp_data.update({"warning": f"Эти субкарты не обнаружены: {failed_subcards}"})
        
    return Response(resp_data)



// View.js
window.EditorView = {
    render() {
        const svg = document.getElementById('drawing-svg');
        svg.innerHTML = '';
        
        EditorModel.points.forEach(point => {
            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', point.x);
            circle.setAttribute('cy', point.y);
            circle.setAttribute('r', 8);
            
            // Цвет по субкарте
            if (point.subcardId) {
                circle.setAttribute('fill', this.getSubcardColor(point.subcardId));
                circle.setAttribute('stroke', '#ffffff');
                circle.setAttribute('stroke-width', '2');
                
                // Тултип с названием субкарты
                const subcard = EditorModel.getSubcard(point.subcardId);
                if (subcard) {
                    const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                    title.textContent = subcard.name;
                    circle.appendChild(title);
                }
            } else {
                // Непривязанные точки — серый цвет
                circle.setAttribute('fill', '#cccccc');
                circle.setAttribute('stroke', '#999999');
            }
            
            circle.dataset.pointId = point.id;
            circle.classList.add('base-point');
            
            svg.appendChild(circle);
        });
    },
    
    getSubcardColor(subcardId) {
        // Генерируем цвет по ID (чтобы одинаковые субкарты всегда одного цвета)
        const colors = ['#e41a1c', '#377eb8', '#4daf4a', '#984ea3', '#ff7f00', '#ffff33'];
        return colors[subcardId % colors.length];
    }
};


