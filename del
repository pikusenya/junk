import re
import json
import uuid
from loguru import logger
from typing import List, Optional
from bs4 import BeautifulSoup
from parser.client import GisZhkhClient
from parser.models import HouseResult, ManagementCompany, UtilityProvider
from typing import Optional, Dict

class GisAdminAPI:
    def __init__(self, client: GisZhkhClient):
        self.client = client
        # Словари для кэширования: ключ = ID организации, значение = объект данных
        self.uk_cache: Dict[str, ManagementCompany] = {}
        self.provider_cache: Dict[str, UtilityProvider] = {}

    def search_house_by_address(self, address: str) -> HouseResult:
        """
        Шаг 1: Поиск дома через Suggest API.
        """
        logger.info(f"Ищу дом по адресу (suggest): {address}")

        payload = {
            "appName": "ГИС ЖКХ",
            "reqId": "ГИС ЖКХ",
            "rmFedCities": True,
            "woFlat": True,
            "addr": address
        }

        try:
            response_json = self.client.request("POST", "/gispa/suggest/api/v4_6", json=payload)

            house_result = HouseResult(
                address=address,
                raw_suggest_response=response_json
            )

            # Парсим массив найденных адресов
            addr_list = response_json.get("addr", [])
            house_result.found_addresses_count = len(addr_list)

            if not addr_list:
                logger.warning(f"По адресу '{address}' не найдено ни одного совпадения")
                house_result.error = "Адрес не найден"
                return house_result

            # Сохраняем все найденные адреса
            house_result.all_found_addresses = [
                item.get("outAddr", "Неизвестный адрес") for item in addr_list
            ]

            # Выбираем первый адрес (addr[0])
            selected_addr = addr_list[0]
            house_result.selected_address_formatted = selected_addr.get("outAddr")

            # Извлекаем GUID из элементов
            # ВАЖНО: Если структура изменится, проверь логику поиска элементов здесь
            elements = selected_addr.get("elements", [])

            region_fias_id = None
            house_fias_id = None

            for element in elements:
                level = element.get("level")
                guid = element.get("guid")

                if level == 1:  # Регион (область/край/республика)
                    region_fias_id = guid
                    logger.debug(f"Найден регион: {element.get('val')} (GUID: {guid})")
                elif level == 8:  # Дом
                    house_fias_id = guid
                    logger.debug(f"Найден дом: {element.get('val')} (GUID: {guid})")

            # Проверяем, что нашли оба ID
            if not region_fias_id or not house_fias_id:
                error_msg = f"Не удалось извлечь region_fias_id или house_fias_id. Найдено: region={region_fias_id}, house={house_fias_id}"
                logger.error(error_msg)
                house_result.error = error_msg
                return house_result

            # Теперь делаем запрос на получение house_id
            house_id = self._get_house_id(region_fias_id, house_fias_id)
            house_result.house_id = house_id

            if not house_id:
                house_result.error = "Не удалось получить house_id из API"

            return house_result

        except Exception as e:
            logger.error(f"Ошибка при поиске адреса {address}: {e}")
            return HouseResult(address=address, error=str(e))

    def _get_house_id(self, region_fias_id: str, house_fias_id: str) -> Optional[str]:
        """
        Шаг 2: Получение house_id через searchController.houseSearch.
        """
        logger.info(f"Получаю house_id для region={region_fias_id}, house={house_fias_id}")

        payload = {
            "id": 1,
            "method": "searchController.houseSearch",
            "params": {
                "region_fias_id": region_fias_id,
                "house_fias_id": house_fias_id
            },
            "jsonrpc": "2.0"
        }

        # Генерируем уникальные GUID для заголовков
        request_guid = str(uuid.uuid4())
        session_guid = "33fd86c1-a9b5-4657-a0c3-ce74afb4d8c6"  # Из твоего браузера

        # Добавляем специфичные заголовки для этого запроса
        headers = {
            "Request-Guid": request_guid,
            "Session-Guid": session_guid
        }

        try:
            response_json = self.client.request("POST", "/api", json=payload, headers=headers)

            # Извлекаем house_id из ответа
            # Структура: {"id": 1, "result": {"id": "house_id"}, "jsonrpc": "2.0"}
            result = response_json.get("result", {})
            house_id = result.get("id")

            if not house_id:
                logger.error(f"В ответе отсутствует result.id. Ответ: {response_json}")
                return None

            logger.info(f"Успешно получен house_id: {house_id}")
            return house_id

        except Exception as e:
            logger.error(f"Ошибка при получении house_id: {e}")
            return None

    def get_house_details(self, house_result: HouseResult) -> HouseResult:
        """
        Шаг 3: Получение ID организаций из __NEXT_DATA__ и запрос их деталей через API.
        """
        if not house_result.house_id:
            logger.warning(f"Нет house_id для получения деталей дома {house_result.address}")
            return house_result

        logger.info(f"Парсинг страницы дома ID: {house_result.house_id}")
        house_url = f"/home/{house_result.house_id}"

        try:
            html_content = self.client.get_html(house_url)
            match = re.search(r'<script id="__NEXT_DATA__" type="application/json">(.*?)</script>', html_content)
            if not match:
                logger.error(f"Не удалось найти __NEXT_DATA__ на странице дома {house_result.house_id}")
                house_result.error = "Не найдены данные страницы (Next.js data)"
                return house_result

            next_data = json.loads(match.group(1))
            house_data = next_data.get("props", {}).get("pageProps", {}).get("result", {}).get("house", {})

            if not house_data:
                house_result.error = "Не найдены данные дома в Next.js"
                return house_result

            # 2. Получаем Управляющую Организацию (с кэшем)
            mgmt_org = house_data.get("managementOrganization")
            if mgmt_org and mgmt_org.get("id"):
                house_result.uo = self._get_management_org_details(mgmt_org["id"])

            # 2. Получаем маппинг "ID организации -> Название услуги"
            service_map = self._get_utility_services_map(house_data)

            # 3. Собираем список всех поставщиков для обработки
            providers_to_process = []
            for rso in house_data.get("resourceProvisionOrganizationList", []):
                if rso.get("id"):
                    providers_to_process.append({"id": rso["id"], "type": "RSO", "name": rso.get("shortName", "")})

            tko_org = house_data.get("tkoOrganization")
            if tko_org and tko_org.get("id"):
                providers_to_process.append({"id": tko_org["id"], "type": "TKO", "name": tko_org.get("shortName", "")})

            # 4. Парсим HTML каждого поставщика (с кэшем)
            for prov in providers_to_process:
                service_name = service_map.get(prov["id"], "Коммунальная услуга")

                provider_details = self._get_provider_details_from_html(
                    provider_id=prov["id"],
                    house_id=house_result.house_id,
                    provider_type=prov["type"],
                    service_type=service_name,
                    default_name=prov["name"]
                )

                if provider_details:
                    house_result.providers.append(provider_details)

            logger.info(f"✅ Дом {house_result.house_id} обработан. УК: {house_result.uo.name if house_result.uo else 'Нет'}, Поставщиков: {len(house_result.providers)}")
            return house_result

        except Exception as e:
            logger.error(f"Ошибка при получении деталей дома {house_result.house_id}: {e}")
            house_result.error = str(e)
            return house_result

    def _get_utility_services_map(self, house_data: dict) -> dict:
        """
        Делает запрос к houseController.getHouseUtilityProviders и возвращает словарь:
        { "provider_id": "Название услуги", ... }
        """
        logger.debug("Запрос списка услуг и поставщиков через API...")
        payload = {
            "id": 1,
            "method": "houseController.getHouseUtilityProviders",
            "params": {
                "managementOrganization": house_data.get("managementOrganization"),
                "fiasHouseCode": house_data.get("fiasHouseCode"),
                "tkoOrganization": house_data.get("tkoOrganization"),
                "resourceProvisionOrganizationList": house_data.get("resourceProvisionOrganizationList", [])
            },
            "jsonrpc": "2.0"
        }
        headers = {"Request-Guid": str(uuid.uuid4()), "Session-Guid": "33fd86c1-a9b5-4657-a0c3-ce74afb4d8c6"}

        service_map = {}
        try:
            response = self.client.request("POST", "/api", json=payload, headers=headers)
            utility_list = response.get("result", {}).get("utilityProviderOrganizations", [])

            for item in utility_list:
                service_name = item.get("utility", {}).get("name", "Неизвестная услуга")
                for org in item.get("organizations", []):
                    org_id = org.get("id")
                    if org_id:
                        # Если организация предоставляет несколько услуг, объединяем их через запятую
                        if org_id in service_map:
                            if service_name not in service_map[org_id]:
                                service_map[org_id] += f", {service_name}"
                        else:
                            service_map[org_id] = service_name

            logger.debug(f"Построена карта услуг для {len(service_map)} организаций.")

        except Exception as e:
            logger.warning(f"Не удалось получить карту услуг через API, будем использовать заглушку: {e}")

        return service_map

    def _get_management_org_details(self, org_id: str) -> Optional[ManagementCompany]:
        # ПРОВЕРКА КЭША
        if org_id in self.uk_cache:
            logger.debug(f"УК {org_id} взята из кэша")
            return self.uk_cache[org_id]

        logger.debug(f"Запрос деталей новой УК по ID: {org_id}")
        payload = {
            "id": 1,
            "method": "houseController.getHouseManagementOrganization",
            "params": {"id": org_id},
            "jsonrpc": "2.0"
        }
        headers = {
            "Request-Guid": str(uuid.uuid4()),
            "Session-Guid": "33fd86c1-a9b5-4657-a0c3-ce74afb4d8c6" # Берем из твоих cookies
        }

        try:
            response = self.client.request("POST", "/api", json=payload, headers=headers)
            result = response.get("result", {}).get("managementOrganization", {})

            contacts = result.get("contacts", {})

            uk_data = ManagementCompany(
                name=result.get("shortName", ""),
                url=contacts.get("urls", [{}])[0].get("value", "") or result.get("url", ""),
                phone=contacts.get("phones", [{}])[0].get("value", ""),
                email=contacts.get("emails", [{}])[0].get("value", ""),
                inn=result.get("inn", ""), ogrn=result.get("ogrn", ""), kpp=result.get("kpp", ""),
                address=result.get("orgAddress", "")
            )

            # СОХРАНЕНИЕ В КЭШ
            self.uk_cache[org_id] = uk_data
            return uk_data

        except Exception as e:
            logger.error(f"Не удалось получить детали УК {org_id}: {e}")
            return None

    def _get_provider_details_from_html(self, provider_id: str, house_id: str, provider_type: str, service_type: str, default_name: str) -> Optional[UtilityProvider]:
        # ПРОВЕРКА КЭША
        if provider_id in self.provider_cache:
            logger.debug(f"Поставщик {provider_id} взят из кэша")
            # Возвращаем копию, чтобы не менять данные в кэше, если вдруг потребуется
            cached_prov = self.provider_cache[provider_id]
            # Обновляем только service_type, так как одна компания может оказывать разные услуги в разных домах
            cached_prov.service_type = service_type
            return cached_prov

        logger.debug(f"Парсинг страницы нового поставщика {provider_type} ({service_type}): {default_name}")
        url = f"/{provider_type.lower()}/{provider_id}/{house_id}"

        try:
            html_content = self.client.get_html(url)
            soup = BeautifulSoup(html_content, 'html.parser')

            # Ищем заголовок h3 с текстом "Основные реквизиты"
            h3_tag = soup.find('h3', string=lambda t: t and 'Основные реквизиты' in t)
            if not h3_tag:
                prov_data = UtilityProvider(provider_id=provider_id, provider_type=provider_type, service_type=service_type, company_name=default_name)
                self.provider_cache[provider_id] = prov_data
                return prov_data

            parent_div = h3_tag.find_parent('div')
            if not parent_div:
                prov_data = UtilityProvider(provider_id=provider_id, provider_type=provider_type, service_type=service_type, company_name=default_name)
                self.provider_cache[provider_id] = prov_data
                return prov_data

            # --- ПАРСИНГ ДАННЫХ ---
            name_tag = parent_div.find('h5')
            company_name = name_tag.get_text(strip=True) if name_tag else default_name

            # ИНН, ОГРН, КПП
            inn = ogrn = kpp = ""
            for label in ["ИНН", "ОГРН", "КПП"]:
                # Ищем span с текстом метки
                span = parent_div.find('span', string=lambda t: t and label in t)
                if span and span.parent:
                    val = span.parent.get_text(strip=True).replace(label, "").strip()
                    if label == "ИНН": inn = val
                    elif label == "ОГРН": ogrn = val
                    elif label == "КПП": kpp = val

            # Адрес (ищем текст "Фактический адрес" и берем следующий div)
            address = ""
            factual_label = parent_div.find(string=lambda t: t and "Фактический адрес" in t)
            if factual_label:
                next_div = factual_label.find_next('div')
                if next_div: address = next_div.get_text(strip=True)

            # Email (ищем ссылку с href="mailto:...")
            email = ""
            email_a = parent_div.find('a', href=lambda h: h and h.startswith('mailto:'))
            if email_a: email = email_a['href'].replace('mailto:', '').strip() or email_a.get_text(strip=True)

            # Телефон (ищем ссылку с href="tel:...")
            phone = ""
            phone_a = parent_div.find('a', href=lambda h: h and h.startswith('tel:'))
            if phone_a:
                # Внутри ссылки может быть div с номером и span с подписью "Аварийная служба"
                # Берем текст первого div, чтобы получить чистый номер
                phone_div = phone_a.find('div')
                phone = phone_div.get_text(strip=True) if phone_div else phone_a['href'].replace('tel:', '').strip()

            # Сайт (ищем любую ссылку, которая НЕ mailto и НЕ tel)
            website = ""
            for a_tag in parent_div.find_all('a'):
                href = a_tag.get('href', '')
                if href and not href.startswith('mailto:') and not href.startswith('tel:') and not href.startswith('#'):
                    website = href
                    break
            # --- КОНЕЦ ПАРСИНГА ---

            prov_data = UtilityProvider(
                provider_id=provider_id, provider_type=provider_type, service_type=service_type,
                company_name=company_name, email=email, phone=phone, url=website,
                inn=inn, ogrn=ogrn, kpp=kpp, address=address
            )

            # СОХРАНЕНИЕ В КЭШ
            self.provider_cache[provider_id] = prov_data
            logger.info(f"✅ Распарсен и сохранен в кэш: {company_name} | Услуга: {service_type} | Email: {email or 'НЕТ'}")
            return prov_data

        except Exception as e:
            logger.error(f"Ошибка при парсинге страницы поставщика {default_name}: {e}")
            return None

