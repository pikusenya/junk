updateSubcardStatusPanel() {
    const list = document.getElementById('linked-subcards-list');
    list.innerHTML = '';
    
    EditorModel.linkedSubcardIds.forEach(subcardId => {
        const subcard = EditorModel.getSubcard(subcardId);
        if (subcard) {
            const li = document.createElement('li');
            li.textContent = subcard.name;
            li.style.color = EditorView.getSubcardColor(subcardId);
            list.appendChild(li);
        }
    });
}
