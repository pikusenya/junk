// Controller.js
async saveFloorPlan() {
    const floorId = this.currentFloorId;
    
    // === 1. Группируем точки по subcard_id ===
    const pointsBySubcard = {};
    EditorModel.points.forEach(point => {
        const subcardId = point.id;  // По твоей логике: point.id = subcard_id
        if (!pointsBySubcard[subcardId]) {
            pointsBySubcard[subcardId] = [];
        }
        pointsBySubcard[subcardId].push({
            id: point.id,
            x: point.x,
            y: point.y
        });
    });
    
    // === 2. Группируем полигоны по subcard_id ===
    const polygonsBySubcard = {};
    EditorModel.polygons.forEach(polygon => {
        const subcardId = polygon.attachedTo;  // attachedTo = point.id = subcard_id
        if (!polygonsBySubcard[subcardId]) {
            polygonsBySubcard[subcardId] = [];
        }
        polygonsBySubcard[subcardId].push({
            attachedTo: polygon.attachedTo,
            color: polygon.color,
            vertices: polygon.vertices.map(v => ({
                id: v.id,
                x: v.x,
                y: v.y
            }))
        });
    });
    
    // === 3. Собираем все уникальные subcard_id ===
    const allSubcardIds = new Set([
        ...Object.keys(pointsBySubcard).map(Number),
        ...Object.keys(polygonsBySubcard).map(Number)
    ]);
    
    // === 4. Формируем массив обновлений ===
    const subcardsUpdates = [];
    
    // 4a. Субкарты с координатами → link_floorplan: true
    allSubcardIds.forEach(subcardId => {
        const coords = {
            points: pointsBySubcard[subcardId] || [],
            polygons: polygonsBySubcard[subcardId] || []
        };
        
        subcardsUpdates.push({
            subcard_id: subcardId,
            coords: coords,
            link_floorplan: true
        });
    });
    
    // 4b. Субкарты, которые были привязаны, но теперь без координат → link_floorplan: false
    if (EditorModel.linkedSubcardIds) {
        EditorModel.linkedSubcardIds.forEach(prevLinkedId => {
            if (!allSubcardIds.has(prevLinkedId)) {
                subcardsUpdates.push({
                    subcard_id: prevLinkedId,
                    coords: {},          // Пустые координаты
                    link_floorplan: false  // Отвязать от этажа
                });
            }
        });
    }
    
    // Если ничего не менялось — выходим
    if (subcardsUpdates.length === 0) {
        alert('Нет изменений для сохранения');
        return;
    }
    
    // === 5. Отправляем на сервер ===
    try {
        const response = await fetch(`/api/floorplans/${floorId}/update/`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',  // ← Важно: JSON, не FormData!
                'X-CSRFToken': getCookie('csrftoken'),
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                subcards_updates: subcardsUpdates
            })
        });
        
        const result = await response.json();
        
        if (response.ok) {
            // Обновляем linkedSubcardIds в модели
            const newlyLinked = subcardsUpdates
                .filter(u => u.link_floorplan)
                .map(u => u.subcard_id);
            EditorModel.linkedSubcardIds = newlyLinked;
            
            alert('✅ Данные сохранены!');
        } else {
            alert('❌ Ошибка: ' + (result.error || JSON.stringify(result)));
        }
    } catch (error) {
        console.error('Save error:', error);
        alert('❌ Ошибка сети');
    }
}
