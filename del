window.EditorController = {
    elements: {},
    selectedPoint: null,
    
    init() {
        // ... существующие слушатели ...
        
        // Клик по точке → открываем модальное окно
        document.getElementById('drawing-svg')
            .addEventListener('click', (e) => {
                if (e.target.classList.contains('base-point')) {
                    const pointId = parseInt(e.target.dataset.pointId);
                    this.openPointSubcardModal(pointId);
                }
            });
        
        // Сохранение привязки
        document.getElementById('btn-save-point-assignment')
            .addEventListener('click', () => this.savePointAssignment());
        
        // Закрытие модального окна
        document.getElementById('btn-close-point-modal')
            .addEventListener('click', () => this.closePointModal());
    },
    
    async openPointSubcardModal(pointId) {
        const point = EditorModel.getPoint(pointId);
        this.selectedPoint = point;
        
        const { modal, select, currentName } = this.elements;
        
        // Заполняем селектор
        this.populateSubcardSelect(point.subcardId);
        
        // Показываем текущую привязку
        if (point.subcardId) {
            const subcard = EditorModel.getSubcard(point.subcardId);
            currentName.textContent = subcard ? subcard.name : 'Неизвестно';
        } else {
            currentName.textContent = 'Не привязано';
        }
        
        modal.classList.remove('hidden');
    },
    
    populateSubcardSelect(selectedId) {
        const { select } = this.elements;
        select.innerHTML = '<option value="">-- Не привязано --</option>';
        
        EditorModel.subcards.forEach(subcard => {
            const option = document.createElement('option');
            option.value = subcard.id;
            option.textContent = subcard.name;
            if (subcard.id === selectedId) {
                option.selected = true;
            }
            select.appendChild(option);
        });
    },
    
    savePointAssignment() {
        const { select } = this.elements;
        const subcardId = select.value ? parseInt(select.value) : null;
        
        if (this.selectedPoint) {
            // Обновляем subcardId у точки
            this.selectedPoint.subcardId = subcardId;
            
            // Если у точки есть полигон — обновляем и его
            if (this.selectedPoint.polygon) {
                this.selectedPoint.polygon.subcardId = subcardId;
            }
            
            // Перерисовываем (чтобы обновить цвет точки)
            EditorView.render();
            
            this.closePointModal();
        }
    },
    
    closePointModal() {
        this.elements.modal.classList.add('hidden');
        this.selectedPoint = null;
    },
    
    // --- СОХРАНЕНИЕ ВСЕХ ДАННЫХ ---
    async saveFloorPlan() {
        const floorId = this.currentFloorId;
        
        // Группируем точки по subcardId
        const pointsBySubcard = this.groupPointsBySubcard();
        
        // Формируем обновления для каждой субкарты
        const subcardsUpdates = Object.entries(pointsBySubcard).map(([subcardId, data]) => ({
            subcard_id: parseInt(subcardId),
            coords: {
                points: data.points,
                polygons: data.polygons
            },
            add_to_floorplan: true  // Если есть точки → привязываем субкарту к этажу
        }));
        
        // Находим субкарты, которые были привязаны, но теперь без точек → отвязываем
        const previouslyLinked = EditorModel.linkedSubcardIds;
        const currentlyLinked = Object.keys(pointsBySubcard).map(id => parseInt(id));
        
        previouslyLinked.forEach(id => {
            if (!currentlyLinked.includes(id)) {
                subcardsUpdates.push({
                    subcard_id: id,
                    remove_from_floorplan: true
                });
            }
        });
        
        const formData = new FormData();
        formData.append('subcards_updates', JSON.stringify(subcardsUpdates));
        
        const response = await fetch(`/api/floorplans/${floorId}/update/`, {
            method: 'PATCH',
            body: formData,
            headers: {
                'X-CSRFToken': getCookie('csrftoken'),
                'Accept': 'application/json'
            }
        });
        
        const result = await response.json();
        
        if (response.ok) {
            alert('Данные сохранены!');
            EditorModel.linkedSubcardIds = currentlyLinked;
        } else {
            alert('Ошибка: ' + result.error);
        }
    },
    
    groupPointsBySubcard() {
        const grouped = {};
        
        EditorModel.points.forEach(point => {
            const subcardId = point.subcardId || 'unassigned';
            
            if (!grouped[subcardId]) {
                grouped[subcardId] = { points: [], polygons: [] };
            }
            
            // Добавляем точку (без subcardId, так как он уже в ключе)
            grouped[subcardId].points.push({
                id: point.id,
                x: point.x,
                y: point.y
            });
            
            // Добавляем полигон если есть
            if (point.polygon) {
                grouped[subcardId].polygons.push({
                    attachedTo: point.id,
                    color: point.polygon.color,
                    vertices: point.polygon.vertices.map(v => ({
                        id: v.id,
                        x: v.x,
                        y: v.y
                    }))
                });
            }
        });
        
        // Убираем непривязанные точки (не отправляем на сервер)
        delete grouped['unassigned'];
        
        return grouped;
    }
};


