// --- 2. Генератор условия триггера ---

function initTriggerGenerator() {
    const container = document.getElementById('trigger-generator');
    const jsonField = document.querySelector('[name="trigger_condition"]');
    
    if (!container || !jsonField) return;
    
    // Слушаем изменения JSON-поля (если пользователь редактирует вручную)
    jsonField.addEventListener('input', function() {
        syncTriggerFormToJSON(jsonField.value);
    });
    
    // Инициализируем форму
    renderTriggerForm(container, jsonField);
}

function renderTriggerForm(container, jsonField) {
    let condition = {};
    try {
        condition = JSON.parse(jsonField.value || '{}');
    } catch (e) {
        condition = {};
    }
    
    container.innerHTML = `
        <label>Тип триггера</label>
        <select id="trigger-type-select">
            <option value="field_change" ${condition.type === 'field_change' ? 'selected' : ''}>Изменение поля</option>
            <option value="schedule" ${condition.type === 'schedule' ? 'selected' : ''}>По расписанию</option>
        </select>
        
        <label>Поле для отслеживания</label>
        <input type="text" id="trigger-field-input" value="${condition.field || ''}" placeholder="Например: status">
        
        <label>Связь с субкартой (опционально)</label>
        <input type="text" id="trigger-relation-input" value="${condition.relation || ''}" placeholder="Например: subcard">
        
        <label>Проверяемое поле в субкарте</label>
        <input type="text" id="trigger-check-field-input" value="${condition.check_field || ''}" placeholder="Например: department">
        
        <label>Ожидаемое значение</label>
        <input type="text" id="trigger-check-value-input" value="${condition.check_value || ''}" placeholder="Например: sales">
        
        <button type="button" id="trigger-apply-btn">Применить в JSON</button>
        <p class="help-text">Нажмите "Применить" для обновления JSON-поля</p>
    `;
    
    // Обработчик кнопки
    document.getElementById('trigger-apply-btn').addEventListener('click', function() {
        const newCondition = {
            type: document.getElementById('trigger-type-select').value,
            field: document.getElementById('trigger-field-input').value || undefined,
            relation: document.getElementById('trigger-relation-input').value || undefined,
            check_field: document.getElementById('trigger-check-field-input').value || undefined,
            check_value: document.getElementById('trigger-check-value-input').value || undefined,
        };
        
        // Удаляем undefined поля
        Object.keys(newCondition).forEach(key => {
            if (newCondition[key] === undefined) delete newCondition[key];
        });
        
        jsonField.value = JSON.stringify(newCondition, null, 2);
        
        // Визуальное подтверждение
        this.textContent = '✅ Применено!';
        setTimeout(() => { this.textContent = 'Применить в JSON'; }, 1500);
    });
}

