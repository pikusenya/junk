import pandas as pd
from loguru import logger
from dataclasses import asdict
from parser.client import GisZhkhClient
from parser.endpoints import GisAdminAPI

def format_found_addresses(found_addresses: list, selected_address: str) -> str:
    """
    Форматирует список найденных адресов для удобного отображения в Excel.
    Выбранный адрес помечается как '(выбран)'.
    """
    if not found_addresses: return ""
    formatted = [f"{addr} (ВЫБРАН)" if addr == selected_address else addr for addr in found_addresses]
    return " | ".join(formatted)


def run_parser(input_file: str, output_file: str):
    logger.add("parser_debug.log", rotation="10 MB", compression="zip", level="DEBUG")
    logger.info("Запуск парсера ГИС ЖКХ с кэшированием...")

    try:
        df_input = pd.read_excel(input_file)
    except FileNotFoundError:
        logger.error(
            f"Файл {input_file} не найден. Создай его и добавь колонку 'address'."
        )
        return

    client = GisZhkhClient()
    api = GisAdminAPI(client)

    results = []

    for index, row in df_input.iterrows():
        address = row['address']
        logger.info(f"Обработка {index + 1}/{len(df_input)}: {address}")

        try:
            # 1. Ищем дом через suggest API
            house_data = api.search_house_by_address(address)

            if house_data.house_id:
                # 2. Получаем детали (УО и Поставщики)
                house_data = api.get_house_details(house_data)

            logger.info(f"Адрес '{address}': найдено вариантов: {house_data.found_addresses_count}")
            results.append(house_data)

        except Exception as e:
            logger.error(f"Критическая ошибка при обработке адреса {address}: {e}")
            results.append(house_data) # Добавляем с ошибкой, чтобы не терять строку

    client.close()
    logger.info("Парсинг завершен. Формирование Excel-отчета...")

    # ==========================================
    # ЛИСТ 1: Основной результат
    # ==========================================
    main_rows = []
    # Находим максимальное количество поставщиков у одного дома, чтобы создать нужное число колонок
    max_providers = max((len(res.providers) for res in results), default=0)

    for res in results:
        row = {
            "Адрес": res.address,
            "Найдено адресов": res.found_addresses_count,
            "Варианты адресов": format_found_addresses(res.all_found_addresses, res.selected_address_formatted),
            "УК Название": res.uo.name if res.uo else "",
            "УК Почта": res.uo.email if res.uo else "",
            "Ошибка": res.error or ""
        }
        # Динамически добавляем колонки для каждого поставщика
        for i, prov in enumerate(res.providers, 1):
            row[f"Услуга_{i}"] = prov.service_type
            row[f"Компания_{i}"] = prov.company_name
            row[f"Почта_{i}"] = prov.email

        main_rows.append(row)

    df_main = pd.DataFrame(main_rows)

    # ==========================================
    # ЛИСТ 2: Реестр УК (из кэша)
    # ==========================================
    uk_registry = [asdict(uk) for uk in api.uk_cache.values()]
    df_uk = pd.DataFrame(uk_registry)

    # ==========================================
    # ЛИСТ 3: Реестр ЖКХ/Поставщиков (из кэша)
    # ==========================================
    provider_registry = [asdict(prov) for prov in api.provider_cache.values()]
    df_provider = pd.DataFrame(provider_registry)

    # ==========================================
    # ЛИСТ 4: Дебаг (упрощенный)
    # ==========================================
    # Исключаем огромные raw-словари, чтобы файл не весил гигабайты
    debug_rows = []
    for res in results:
        d = asdict(res)
        d.pop('raw_suggest_response', None)
        debug_rows.append(d)
    df_debug = pd.json_normalize(debug_rows)

    # ==========================================
    # ЗАПИСЬ В EXCEL
    # ==========================================
    try:
        with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
            df_main.to_excel(writer, sheet_name='Основной_результат', index=False)
            df_uk.to_excel(writer, sheet_name='Реестр_УК', index=False)
            df_provider.to_excel(writer, sheet_name='Реестр_Поставщиков', index=False)
            df_debug.to_excel(writer, sheet_name='Debug', index=False)

        logger.success(f"✅ Отчет успешно сохранен в {output_file}")
        logger.info(f"Статистика: Обработано домов: {len(results)}, Уникальных УК: {len(api.uk_cache)}, Уникальных поставщиков: {len(api.provider_cache)}")

    except Exception as e:
        logger.error(f"Ошибка при сохранении Excel файла: {e}")
        logger.info("Попробуйте закрыть файл output_contacts.xlsx, если он открыт в Excel, и запустить скрипт снова.")


if __name__ == "__main__":
    run_parser("input_addresses.xlsx", "output_contacts.xlsx")

